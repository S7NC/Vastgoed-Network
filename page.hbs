{{!< default}}
{{#post}}
<main class="article-shell">
    <article class="{{post_class}}">
        {{#match @page.show_title_and_feature_image "!=" false}}
        <header class="article-header">
            <p class="eyebrow">Vastgoed.net</p>
            <h1>{{title}}</h1>
            {{#if custom_excerpt}}<p class="article-deck">{{custom_excerpt}}</p>{{/if}}
        </header>
        {{#if feature_image}}
            <figure class="article-feature">
                <img src="{{img_url feature_image size="l"}}" srcset="{{img_url feature_image size="s"}} 400w, {{img_url feature_image size="m"}} 800w, {{img_url feature_image size="l"}} 1200w, {{img_url feature_image size="xl"}} 2000w" sizes="(max-width: 1200px) 100vw, 1200px" alt="{{feature_image_alt}}">
                {{#if feature_image_caption}}<figcaption>{{feature_image_caption}}</figcaption>{{/if}}
            </figure>
        {{/if}}
        {{/match}}
        <div class="gh-content">{{content}}</div>
    </article>
</main>
{{/post}}
