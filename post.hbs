{{!< default}}
{{#post}}
<main class="article-shell">
    <article class="{{post_class}}">
        <header class="article-header">
            <a class="back-link" href="/guides/">← All guides</a>
            <p class="eyebrow">{{#primary_tag}}{{name}}{{else}}Field notes{{/primary_tag}}</p>
            <h1>{{title}}</h1>
            {{#if custom_excerpt}}<p class="article-deck">{{custom_excerpt}}</p>{{/if}}
            <div class="article-byline"><span>{{authors}}</span><time datetime="{{date format="YYYY-MM-DD"}}">{{date format="D MMM YYYY"}}</time><span>{{reading_time}}</span></div>
        </header>
        {{#if feature_image}}
            <figure class="article-feature">
                <img src="{{img_url feature_image size="l"}}" srcset="{{img_url feature_image size="s"}} 400w, {{img_url feature_image size="m"}} 800w, {{img_url feature_image size="l"}} 1200w, {{img_url feature_image size="xl"}} 2000w" sizes="(max-width: 1200px) 100vw, 1200px" alt="{{feature_image_alt}}" fetchpriority="high">
                {{#if feature_image_caption}}<figcaption>{{feature_image_caption}}</figcaption>{{/if}}
            </figure>
        {{/if}}
        <div class="gh-content">{{content}}</div>
        <footer class="article-footer"><a class="text-link" href="/guides/">More perspectives <span aria-hidden="true">↗</span></a><a class="text-link" href="/">Find your next place <span aria-hidden="true">↗</span></a></footer>
    </article>
</main>
{{/post}}
